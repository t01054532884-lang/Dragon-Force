# Firebase 웹 앱 설정(Firebase 콘솔 → 프로젝트 설정 → 내 앱 → 웹 앱 → SDK 설정 "구성")
# 이 파일을 .env.local 로 복사해 값을 채운다(.env.local 은 git에 올라가지 않음).
# iOS 빌드는 Codemagic 환경 변수에 같은 이름으로 넣는다. 값이 없으면 클라우드 저장은 꺼지고 기기에만 저장된다.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# RevenueCat App Store 공개 키(appl_…, RevenueCat → API keys). iOS 빌드에서만 쓰임 — 없으면 결제 꺼짐. 비밀 키(sk_…)는 여기 넣지 않는다(서버 비밀 값).
VITE_REVENUECAT_IOS_KEY=
