rules_version = '2';
// 클라우드 저장 1단계(docs/CLOUD.md): 본인 문서만, 버전(rev)은 하나씩만 올라감 → 두 기기가 동시에 써도 한쪽만 성공
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      function isMe() { return request.auth != null && request.auth.uid == uid; }
      function validSave() {
        let d = request.resource.data;
        return d.keys().hasOnly(['save', 'rev', 'summary', 'schema', 'platform', 'updatedAt'])
          && d.save is string && d.save.size() < 400000
          && d.rev is int
          && d.updatedAt == request.time;
      }
      allow read, delete: if isMe();
      allow create: if isMe() && validSave() && request.resource.data.rev == 1;
      allow update: if isMe() && validSave() && request.resource.data.rev == resource.data.rev + 1;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
