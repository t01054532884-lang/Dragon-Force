{
  "name": "dragon-force",
  "private": true,
  "version": "1.0.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:ios": "tsc --noEmit && vite build --mode ios && cap sync ios",
    "build:android": "tsc --noEmit && vite build --mode android && cap sync android",
    "build:toss": "tsc --noEmit && vite build --mode toss && ait build",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "@apps-in-toss/web-framework": "^3.10.0",
    "@capacitor-community/admob": "8.3.0",
    "@capacitor-community/apple-sign-in": "^7.1.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/preferences": "^8.0.1",
    "@revenuecat/purchases-capacitor": "^14.1.2",
    "firebase": "^12.19.0",
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/cli": "^8.6.2",
    "@capacitor/ios": "^8.6.2",
    "typescript": "~5.9.3",
    "vite": "^8.3.8",
    "vitest": "^3.2.7"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
